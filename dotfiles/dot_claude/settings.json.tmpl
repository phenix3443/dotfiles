{
  "env": {
    "ANTHROPIC_AUTH_TOKEN": "code-switch-r",
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:18100",
    "CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS": "1"
  },
  "permissions": {
    "allow": [
      "Localhost",
      "127.0.0.1",
      "*.local",
      "Bash(pwd)",
      "Bash(ls)",
      "Bash(ls -la)",
      "Bash(ls -l)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(git *)",
      "Bash(which *)",
      "Bash(* --version)",
      "Bash(* -v)",
      "Bash(* --help)",
      "Bash(* --help *)",
      "Bash(npm *)",
      "Bash(yarn *)",
      "Bash(pnpm *)",
      "Bash(bun *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(pip *)",
      "Bash(pip3 *)",
      "Bash(go *)",
      "Bash(cargo *)",
      "Bash(rustc *)",
      "Bash(make *)",
      "Bash(cmake *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(docker *)",
      "Bash(docker-compose *)",
      "Bash(kubectl *)",
      "Bash(psql *)",
      "Bash(mysql *)",
      "Bash(redis-cli *)",
      "Bash(mongo *)",
      "Bash(jest *)",
      "Bash(vitest *)",
      "Bash(pytest *)",
      "Bash(uname -a)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -rf /*)",
      "Bash(sudo *)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Bash(wget * | sh)",
      "Bash(wget * | bash)"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(git clean *)",
      "Bash(shred *)"
    ],
    "defaultMode": "bypassPermissions",
    "skipDangerousModePermissionPrompt": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/rtk-rewrite.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/fix-to-code-reminder.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true
  }
}
