{
  "env": {
    "ANTHROPIC_BASE_URL": "https://api.skyapi.org"
  },
  "permissions": {
    "allow": [
      "localhost",
      "127.0.0.1",
      "*.local",
      "Bash(pwd)",
      "Bash(ls)",
      "Bash(ls -la)",
      "Bash(ls -l)",
      "Bash(git status)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git branch)",
      "Bash(git branch *)",
      "Bash(git show *)",
      "Bash(git fetch)",
      "Bash(git fetch *)",
      "Bash(git remote)",
      "Bash(git remote *)",
      "Bash(git rev-parse *)",
      "Bash(git describe *)",
      "Bash(git stash list)",
      "Bash(which *)",
      "Bash(* --version)",
      "Bash(* -v)",
      "Bash(* --help)",
      "Bash(* --help *)",
      "Bash(npm run *)",
      "Bash(npm ls)",
      "Bash(npm ls *)",
      "Bash(npm list)",
      "Bash(npm list *)",
      "Bash(npx *)",
      "Bash(make *)",
      "Bash(go list *)",
      "Bash(go vet *)",
      "Bash(cargo check *)",
      "Bash(docker ps)",
      "Bash(docker ps *)",
      "Bash(docker images)",
      "Bash(docker images *)",
      "Bash(uname -a)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -rf /*)",
      "Bash(sudo *)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Bash(wget * | sh)",
      "Bash(wget * | bash)"
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true
  }
}
